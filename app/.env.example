APP_NAME=Tcloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tcloudstorage
DB_USERNAME=cloud
DB_PASSWORD=cloud123

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=1440

FILESYSTEM_DISK=local
STORAGE_PATH=/var/www/html/storage/app

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Modulo IA - Transcriptor ASR externo (LAN)
# URL base de la API del transcriptor (LAN interna)
TRANSCRIPTOR_BASE_URL=http://192.168.0.138:9000
# Bearer token de autorizacion de la API (dejar vacio si la API no usa auth)
TRANSCRIPTOR_API_KEY=
# Idioma por defecto de las transcripciones (es, en, ...)
TRANSCRIPTOR_LANGUAGE=es
# Modo de correccion de idioma del nodo: off | async | auto
TRANSCRIPTOR_LANG_FIX=async
# Cuantos archivos sin transcripcion toma el scanner por storage por ciclo (default 100)
TRANSCRIPTOR_SCAN_BATCH=100
# Dias hacia atras que escanea el scanner por defecto (0 = solo hoy)
TRANSCRIPTOR_SCAN_DAYS_BACK=0
