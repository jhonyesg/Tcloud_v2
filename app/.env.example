APP_NAME=Tcloud
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tcloudstorage
DB_USERNAME=cloud
DB_PASSWORD=cloud123

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=1440

FILESYSTEM_DISK=local
STORAGE_PATH=/var/www/html/storage/app

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Modulo IA - Transcriptor ASR externo (LAN)
# URL base de la API del transcriptor (LAN interna)
TRANSCRIPTOR_BASE_URL=http://192.168.0.138:9000
# Bearer token de autorizacion de la API (dejar vacio si la API no usa auth)
TRANSCRIPTOR_API_KEY=
# Idioma por defecto de las transcripciones (es, en, ...)
TRANSCRIPTOR_LANGUAGE=es
# Modo de correccion de idioma del nodo: off | async | auto
TRANSCRIPTOR_LANG_FIX=async
# Cuantos archivos sin transcripcion toma el scanner por storage por ciclo (default 100)
TRANSCRIPTOR_SCAN_BATCH=100
# Dias hacia atras que escanea el scanner por defecto (0 = solo hoy)
TRANSCRIPTOR_SCAN_DAYS_BACK=0

# Modulo IA - Correcciones del transcriptor (admin /ia/correcciones)
# Minutos despues de una accion masiva durante los cuales se puede deshacer (default 5)
CORRECTIONS_UNDO_WINDOW_MINUTES=5
# Maximo de IDs por bulk approve/reject/destroy (default 500)
CORRECTIONS_BULK_MAX_IDS=500
# Dias de retencion del log de undo antes del cleanup job (default 7)
CORRECTIONS_UNDO_LOG_RETENTION_DAYS=7
# Minimo de palabras para que un productor automatico proponga una correccion.
# NO bajar de 3: los bigramas tipo "of love"->"de love" generan espanglish
CORRECTIONS_MIN_SUGGESTION_WORDS=3
# Ejemplos de contexto: cuantas apariciones se muestran al moderar (default 5)
CORRECTIONS_CONTEXT_EXAMPLES=5
# Filas que se traen antes de deduplicar por transcripcion (default 30)
CORRECTIONS_CONTEXT_SCAN_LIMIT=30
# statement_timeout de la busqueda de ejemplos, en ms (default 10000)
CORRECTIONS_CONTEXT_TIMEOUT_MS=10000
# TTL de la cache de ejemplos, en segundos (default 604800 = 7 dias)
CORRECTIONS_CONTEXT_CACHE_TTL=604800
# Longitud minima de la sonda de busqueda. NO bajar de 3: pg_trgm no puede
# servir patrones mas cortos y la consulta degrada a seq scan de 8,3 GB
CORRECTIONS_CONTEXT_MIN_PROBE_LENGTH=3

# Modulo IA - AI-powered corrector suggester (corrections-ai-suggest-context-aware)
# Habilitar/deshabilitar el suggester LLM-powered (cambios 2026-08-01)
LLM_CORRECTION_ENABLED=true
# Endpoint OpenAI-compatible. Default Kilo Gateway (mismo proveedor que este chat).
LLM_BASE_URL=https://api.kilo.ai/api/gateway
# API key del LLM (OBLIGATORIA para que el suggester funcione)
LLM_API_KEY=
# Modelo. Por defecto el mismo que se usa en este chat.
LLM_MODEL=minimax/minimax-m3
# Timeout HTTP (default 60s)
LLM_TIMEOUT_SECONDS=60
# Maximo de tokens en la respuesta del LLM (default 4000)
LLM_MAX_TOKENS=4000
# Temperatura (default 0.2, baja creatividad para minimizar alucinaciones)
LLM_TEMPERATURE=0.2
# Sample size default (default 200 segmentos por corrida del cron)
LLM_SAMPLE_SIZE_DEFAULT=200
# Ventana de dias default (default 1 = solo transcripciones de hoy)
LLM_DAYS_BACK_DEFAULT=1

# Sincronizacion de archivos disco <-> BD (storage_sync)
# Interruptor maestro. En false no se escanea, no se crea y no se borra nada.
STORAGE_SYNC_ENABLED=true
# Puntos de montaje que DEBEN estar activos, separados por coma. Si uno se cae,
# MountGuard lo detecta y el sync deja de escanear esa rama en vez de leer el
# directorio vacio como "borraron todo el contenido".
# Declarar aqui TODO montaje que contenga storages, sea NFS o volumen de bloque
# local: un ext4 que no monta deja el punto de montaje como directorio vacio y
# legible, indistinguible de un NFS caido.
STORAGE_SYNC_EXPECTED_MOUNTS=
# Archivo centinela que debe existir en la raiz de cada montaje esperado. Vacio
# = no se exige. Detecta el caso en que el montaje esta activo pero vacio.
STORAGE_SYNC_MOUNT_SENTINEL=
# Guardas de purga: impiden que un escaneo enganoso borre filas en masa.
STORAGE_SYNC_PRUNE_ENABLED=true
# Rechazar la purga cuando el disco aparece vacio y la BD no lo esta.
STORAGE_SYNC_PRUNE_REFUSE_ON_EMPTY=true
# Por debajo de este numero de filas no se aplica la regla de proporcion.
STORAGE_SYNC_PRUNE_MIN_ROWS=5
# Proporcion maxima de la carpeta que una purga automatica puede borrar.
# El boton Actualizar de la UI es una orden explicita y se salta este limite.
STORAGE_SYNC_PRUNE_MAX_RATIO=0.34
